# LLM provider. Any OpenAI-compatible chat-completions endpoint works.
# A funded key is required for live agent runs; the eval harness runs offline
# from recorded fixtures and needs none.
#
# These three are the boot configuration. Anything set on the Settings screen
# overrides them without a restart, and clearing a field there falls back here.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-sonnet-4.5

# Where the API listens, and the origin used to build tracked resume links.
# PUBLIC_BASE_URL must be reachable by whoever opens the resume, so a tunnel
# host goes here when demoing tracked links to a real recipient.
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787

# Optional: override the SQLite location. Defaults to ./data/command-center.db
# DATABASE_PATH=

# Optional: `json` emits one structured log object per line.
# LOG_FORMAT=json
# LOG_LEVEL=info

# Google Sheets + Gmail credentials are NOT read from this file.
# Run `npm run connect google` — the OAuth refresh token is written straight
# into the connectors table so it never sits in a dotfile.
#
# Likewise `npm run connect notion` for the Notion integration token.
#
# Optional fallback for all three apps: Composio brokers the OAuth for you, so
# connecting is one click on a hosted consent link — no Google Cloud project
# and no Notion integration secret. Free tier covers this app; get a key from
# https://platform.composio.dev → Settings → API Keys (copy the whole value,
# it is shown once). Direct credentials always win when both are set.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=primary
